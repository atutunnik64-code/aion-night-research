@app.get('/')
async def index():
    return FileResponse(
        STATIC / 'index.html',
        headers={
            'Cache-Control':'no-store, no-cache, must-revalidate, max-age=0',
            'Pragma':'no-cache',
            'Expires':'0',
        },
    )

@app.get('/api/health')
async def health():
    tm=trading_mode.status()
    return {'ok': True, 'name':'AION Crypto Radar', 'version':'0.11.58',
            'mode':tm['effective_mode'], 'requested_mode':tm['mode'], 'sources':['live','demo']}

@app.get('/api/research/futures-standard')
async def futures_standard_status():
    return futures_extension_policy.status()

@app.get('/api/scan')
async def scan(amount: float = Query(10000.0, gt=0, le=1_000_000), source: Literal['live','demo'] = 'live'):
    if source=='live':
        snap=automation.latest_broad
        if snap:
            return {**snap,'served_from_auto':True,'snapshot_amount':automation.amount,'requested_amount':amount}
        return {'ready':False,'reason':'AUTO_SCAN_NOT_READY','requested_amount':amount,'source_mode':source}
    return await radar.scan(amount, source)

@app.post('/api/scan/refresh')
async def scan_refresh(amount: float = Query(10000.0, gt=0, le=1_000_000), source: Literal['live','demo'] = 'live'):
    if source=='live':
        async with automation.market_lock:
            return await radar.scan(amount, source)
    return await radar.scan(amount, source)

@app.get('/api/hot')
async def hot():
    if automation.enabled and automation.latest_hot:
        return {**automation.latest_hot,'served_from_auto':True}
    return await radar.hot_scan()

