    return execution_engine.decision_summary(limit,hours)

@app.post('/api/execution/config')
async def execution_config(payload: dict = Body(...)):
    if 'enabled' in payload: execution_engine.enabled=bool(payload['enabled'])
    if 'max_notional' in payload:
        execution_engine.max_notional=max(10.0,min(100000.0,float(payload['max_notional'])))
        risk_manager.max_notional=execution_engine.max_notional
    if 'min_score' in payload: risk_manager.min_score=max(0.0,min(100.0,float(payload['min_score'])))
    if 'min_net_pct' in payload: risk_manager.min_net_pct=max(0.0,float(payload['min_net_pct']))
    if 'max_daily_loss' in payload: risk_manager.max_daily_loss=max(1.0,float(payload['max_daily_loss']))
    return execution_engine.summary(25)

