@app.get('/api/strategy/netting')
async def netting_status():
    broad=automation.latest_broad or {}
    rows=list(broad.get('full_loop_opportunities') or [])+list(broad.get('series_ready_opportunities') or [])
    return rebalance_netting.plan(rows)

def _strategy_portfolio_snapshot():
    broad=automation.latest_broad or {}
    tradeable=list(broad.get('full_loop_opportunities') or [])+list(broad.get('series_ready_opportunities') or [])
    live_status=live_executor.status()
    quarantined=set(live_status.get('live_quarantined_venues') or [])
    live_venues=[v for v in (live_status.get('verified_ready') or []) if v not in quarantined]
    return strategy_portfolio.snapshot(
        classic=tradeable,
        basis=basis_funding_scanner.status().get('opportunities') or [],
        triangles=triangle_scanner.status().get('opportunities') or [],
        stable=stablecoin_scanner.status().get('opportunities') or [],
        live_venues=live_venues,
    )

@app.get('/api/strategy/portfolio')
async def strategy_portfolio_status():
    return _strategy_portfolio_snapshot()

