import asyncio
from pathlib import Path
from typing import Literal
from fastapi import FastAPI, Query, Body
from fastapi.responses import FileResponse
from fastapi.staticfiles import StaticFiles
from app.services.radar import radar
from app.services.coinex_bbo import coinex_bbo
from app.services.opportunity_memory import memory
from app.services.automation import AutomationController
from app.services.paper_engine import paper_engine
from app.services.capital_manager import capital_manager
from app.services.execution_engine import execution_engine
from app.services.risk_manager import risk_manager
from app.services.live_executor import live_executor
from app.services.private_trading import reload_live_credentials, verify_live_credentials
from app.services.autopilot import autopilot
from app.services.inventory_guard import inventory_guard
from app.services.demo_executor import demo_executor
from app.services.demo_trading import bybit_apply_demo_funds, reload_demo_credentials, verify_demo_credentials
from app.services.demo_wallet import demo_wallet
from app.services.trading_mode import trading_mode
from app.services.depth_guard import depth_guard
from app.services.hot_book_cache import hot_book_cache
from app.services.hot_signal_engine import hot_signal_engine
from app.services.order_rules import order_rules_registry
from app.services.coinw_bitget_audit import coinw_bitget_audit
from app.services.wide_hunt_audit import wide_hunt_audit

app = FastAPI(title='AION Crypto Radar', version='0.11.14')
STATIC = Path(__file__).parent / 'static'
automation = AutomationController(radar)
app.mount('/static', StaticFiles(directory=STATIC), name='static')

@app.get('/')
async def index():
    return FileResponse(STATIC / 'index.html')

@app.get('/api/health')
async def health():
    tm=trading_mode.status()
    return {'ok': True, 'name':'AION Crypto Radar', 'version':'0.11.14',
            'mode':tm['effective_mode'], 'requested_mode':tm['mode'], 'sources':['live','demo']}

@app.get('/api/scan')
async def scan(amount: float = Query(10000.0, gt=0, le=1_000_000), source: Literal['live','demo'] = 'live'):
    return await radar.scan(amount, source)

@app.get('/api/hot')
async def hot():
    if automation.enabled and automation.latest_hot:
        return {**automation.latest_hot,'served_from_auto':True}
    return await radar.hot_scan()

@app.get('/api/pilot/coinw-bitget')
async def coinw_bitget_pilot(amount: float = Query(25.0, ge=10, le=1000)):
    return await coinw_bitget_audit.run(amount)

@app.get('/api/pilot/coinw-bitget/last')
async def coinw_bitget_pilot_last():
    return coinw_bitget_audit.snapshot()

@app.get('/api/pilot/wide')
async def wide_hunt_pilot(amount: float = Query(25.0, ge=10, le=1000)):
    return await wide_hunt_audit.run(amount)

@app.get('/api/pilot/wide/last')
async def wide_hunt_pilot_last():
    return wide_hunt_audit.snapshot()

@app.get('/api/coinex-status')
async def coinex_status():
    return coinex_bbo.status()

@app.get('/api/latency')
async def latency(amount: float = Query(10000.0, gt=0, le=1_000_000)):
    if automation.enabled and automation.latest_latency and abs(float(automation.amount)-float(amount))<1e-9:
        return {**automation.latest_latency,'served_from_auto':True}
    return await radar.latency_scan(amount)

@app.get('/api/quality')
async def quality(limit: int = Query(50, ge=1, le=200)):
    return {'routes': memory.leaderboard(limit=limit), 'count': len(memory.leaderboard(limit=limit))}

@app.get('/api/long-windows')
async def long_windows(min_seconds: int = Query(300, ge=30, le=86400), limit: int = Query(50, ge=1, le=200)):
    rows=memory.long_windows(min_seconds=min_seconds, limit=limit)
    return {'min_seconds':min_seconds,'routes':rows,'count':len(rows)}

@app.on_event('startup')
async def start_automation():
    reload_live_credentials()
    asyncio.create_task(verify_live_credentials(),name='live-credential-readonly-verify')
    await depth_guard.start()
    await automation.start()
    await coinw_bitget_audit.start_auto(interval=30.0,amount=25.0)
    await wide_hunt_audit.start_auto(interval=30.0,amount=25.0)

@app.on_event('shutdown')
async def stop_hot_books():
    await coinw_bitget_audit.stop_auto()
    await wide_hunt_audit.stop_auto()
    await depth_guard.stop()

@app.get('/api/hot-books')
async def hot_books_status():
    return depth_guard.status()

@app.get('/api/ws-signals')
async def ws_signals_status():
    return hot_signal_engine.status()

@app.get('/api/order-rules/status')
async def order_rules_status():
    return order_rules_registry.status()

@app.get('/api/automation')
async def automation_status():
    return automation.status()

@app.get('/api/paper-trades')
async def paper_trades(limit: int = Query(50, ge=1, le=200)):
    return paper_engine.summary(limit)

@app.get('/api/capital')
async def capital_status():
    return capital_manager.status()

@app.post('/api/capital')
async def capital_update(payload: dict = Body(...)):
    return capital_manager.update(payload)

@app.get('/api/auto-snapshot')
async def auto_snapshot():
    return automation.snapshot()

@app.get('/api/execution')
async def execution_status(limit: int = Query(50, ge=1, le=200)):
    return execution_engine.summary(limit)

@app.get('/api/execution/decisions')
async def execution_decisions(limit: int = Query(100, ge=1, le=500), hours: float = Query(24.0, ge=1, le=720)):
    return execution_engine.decision_summary(limit,hours)

@app.post('/api/execution/config')
async def execution_config(payload: dict = Body(...)):
    if 'enabled' in payload: execution_engine.enabled=bool(payload['enabled'])
    if 'max_notional' in payload:
        execution_engine.max_notional=max(10.0,min(100000.0,float(payload['max_notional'])))
        risk_manager.max_notional=execution_engine.max_notional
    if 'min_score' in payload: risk_manager.min_score=max(0.0,min(100.0,float(payload['min_score'])))
    if 'min_net_pct' in payload: risk_manager.min_net_pct=max(0.0,float(payload['min_net_pct']))
    if 'max_daily_loss' in payload: risk_manager.max_daily_loss=max(1.0,float(payload['max_daily_loss']))
    return execution_engine.summary(25)

@app.get('/api/live/status')
async def live_status():
    return live_executor.status()

@app.post('/api/live/reload-keys')
async def live_reload_keys():
    return {'ok':True,'credentials':reload_live_credentials(),'live':live_executor.status()}

@app.get('/api/live/verify')
async def live_verify():
    return {'ok':True,'venues':await verify_live_credentials(),'live':live_executor.status()}

@app.post('/api/live/kill-reset')
async def live_kill_reset():
    return live_executor.reset_kill_switch()

@app.get('/api/autopilot')
async def autopilot_status():
    return autopilot.status()

@app.post('/api/autopilot')
async def autopilot_update(payload: dict = Body(...)):
    return autopilot.update(payload)

@app.get('/api/inventory')
async def inventory_status():
    return inventory_guard.status()

@app.post('/api/inventory/reset-targets')
async def inventory_reset_targets():
    return inventory_guard.reset_targets()

@app.post('/api/live/file-gate')
async def live_file_gate(payload: dict = Body(...)):
    return live_executor.set_file_gate(bool(payload.get('enabled')),str(payload.get('confirmation') or ''))


@app.get('/api/trading-mode')
async def trading_mode_status():
    return trading_mode.status()

@app.post('/api/trading-mode')
async def trading_mode_update(payload: dict = Body(...)):
    return trading_mode.set(str(payload.get('mode') or ''),str(payload.get('confirmation') or ''))

@app.get('/api/demo/status')
async def demo_status():
    return demo_executor.status()

@app.post('/api/demo/kill-reset')
async def demo_kill_reset():
    return demo_executor.reset_kill_switch()

@app.post('/api/demo/bybit-funds')
async def demo_bybit_funds(payload: dict = Body(...)):
    return await bybit_apply_demo_funds(payload.get('funds') or payload)

@app.post('/api/demo/wallet-reset')
async def demo_wallet_reset():
    return demo_wallet.reset()

@app.post('/api/demo/reload-keys')
async def demo_reload_keys():
    return {'ok':True,'credentials':reload_demo_credentials(),'demo':demo_executor.status()}

@app.get('/api/demo/verify')
async def demo_verify():
    return {'ok':True,'venues':await verify_demo_credentials(),'demo':demo_executor.status()}



