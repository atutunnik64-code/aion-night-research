:root{font-family:"Segoe UI Variable Display","Segoe UI Light","Helvetica Neue",Arial,sans-serif;color:#24282d;background:#fff;color-scheme:light;--ink:#24282d;--muted:#97a2b2;--line:#e8edf2;--panel:#fff;--cyan:#13bedc;--teal:#10c8b6;--lime:#b6df19;--pink:#f05ab2;--violet:#bc30df;--green:#20c66b;--danger:#d45a6a}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:#fff;color:var(--ink);font-weight:350}button,input,select{font:inherit}button,a{transition:.18s ease}main{width:min(1600px,94vw);margin:0 auto;padding:18px 0 54px}.hero{height:300px;position:relative;overflow:hidden;display:flex;align-items:flex-end;justify-content:center}.hero:after{content:"";position:absolute;left:7%;right:7%;bottom:4px;height:90px;background:radial-gradient(ellipse at center,rgba(61,179,197,.06),transparent 66%);pointer-events:none}#network-canvas{position:absolute;inset:0;width:100%;height:100%;display:block;pointer-events:none}.hero-title{position:relative;z-index:2;text-align:center;padding-bottom:2px}.hero-title h1{margin:0;font-size:clamp(58px,6vw,102px);font-weight:200;letter-spacing:-.055em;line-height:.9}.hero-title h2{margin:11px 0 0;font-size:clamp(20px,2vw,31px);font-weight:300;letter-spacing:.02em}.hero-title p{margin:8px 0 0;color:#a5afbd;font-size:15px;letter-spacing:.02em}.hero-side{position:absolute;z-index:3;color:#9aa5b4;font-size:10px;letter-spacing:.16em;line-height:1.45}.hero-side-left{left:18px;top:26px}.hero-side-left strong{display:block;color:#2c3137;font-size:18px;font-weight:350;letter-spacing:.2em}.hero-side span{display:block;width:30px;height:1px;background:#9fa9b7;margin:10px 0}.hero-side-right{right:18px;top:95px;text-align:left}.coverage-bar{display:flex;align-items:center;justify-content:center;gap:30px;min-height:82px;border-bottom:1px solid #f3f5f7}.coverage-bar article{display:flex;align-items:baseline;gap:12px}.coverage-bar strong{font-size:34px;font-weight:300;letter-spacing:-.04em}.coverage-bar span{color:#9aa5b4;font-size:12px}.coverage-bar>i{height:34px;width:1px;background:#dfe5ea}.coverage-bar>p{margin:0;color:#9ca8b7;font-size:9px;letter-spacing:.13em;line-height:1.45}.dot{display:inline-block;width:9px;height:9px;border-radius:50%}.dot.green{background:var(--green)}.dot.blue{background:#8dbeda}.feature-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:14px;margin:18px 0}.feature-card{min-height:130px;padding:20px 24px;border:1px solid var(--line);border-radius:17px;text-decoration:none;color:inherit;display:grid;grid-template-columns:auto 1fr auto;gap:16px;align-items:start;background:#fff;box-shadow:0 5px 22px rgba(27,43,58,.025)}.feature-card:hover{transform:translateY(-2px);box-shadow:0 12px 34px rgba(27,43,58,.06)}.feature-card h3{font-size:19px;font-weight:350;margin:8px 0 8px}.feature-card p{margin:0;color:#98a4b4;font-size:12px;line-height:1.45}.feature-card>b{font-size:25px;font-weight:200;margin-top:9px}.feature-icon,.big-icon{width:52px;height:52px;border-radius:50%;display:grid;place-items:center;font-size:25px;font-weight:300}.cyan .feature-icon{background:#dff8fd;color:#05add3}.mint .feature-icon,.big-icon.mint{background:#dffaf5;color:#09bfa7}.pink .feature-icon{background:#ffe4f2;color:#eb3699}.violet .feature-icon{background:#f4e2fb;color:#ad2dd5}.work-grid{display:grid;grid-template-columns:1.15fr .95fr .95fr;gap:14px;margin-top:14px}.work-card,.section-card,.diagnostics{border:1px solid var(--line);background:#fff;border-radius:18px;box-shadow:0 8px 28px rgba(32,46,59,.035)}.work-card{padding:22px}.work-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:18px}.work-head h2{font-size:22px;font-weight:350;margin:0;letter-spacing:-.02em}.work-head p{margin:4px 0 0;color:#a0aaba;font-size:11px;line-height:1.45}.live-pill{font-size:9px;letter-spacing:.13em;color:#789085;border:1px solid #dff0e7;border-radius:999px;padding:7px 10px;display:flex;align-items:center;gap:6px}.live-pill i{width:7px;height:7px;background:var(--green);border-radius:50%}.settings-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.settings-grid label,.owner-limit{font-size:11px;color:#8d98a8}.settings-grid input,.settings-grid select,.owner-limit input{width:100%;margin-top:6px;border:1px solid #dfe6ec;border-radius:12px;padding:12px 13px;background:#fbfcfd;color:#34383d;outline:none}.settings-grid select{appearance:none;background-image:linear-gradient(45deg,transparent 50%,#8493a1 50%),linear-gradient(135deg,#8493a1 50%,transparent 50%);background-position:calc(100% - 17px) 50%,calc(100% - 12px) 50%;background-size:5px 5px,5px 5px;background-repeat:no-repeat;padding-right:32px}.settings-grid input:focus,.settings-grid select:focus,.owner-limit input:focus{border-color:#b9ccd9;box-shadow:0 0 0 3px rgba(102,181,202,.08)}.check{display:flex;align-items:center;gap:8px;font-size:11px;color:#8e99a8;margin:14px 0}.check input{width:auto;margin:0}.control-row,.toolbar,.step-actions{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.control-row.compact{margin-top:12px}.primary-action,.quiet-action,.outline-action,.button-link,.text-button,.text-danger{appearance:none;border-radius:11px;padding:11px 15px;font-size:12px;cursor:pointer;text-decoration:none;display:inline-flex;justify-content:center;align-items:center;border:1px solid #dfe5eb;background:#fff;color:#3f454c}.primary-action{background:linear-gradient(135deg,#252b30,#11161a);color:#fff;border-color:#151a1e;min-width:190px;box-shadow:0 8px 20px rgba(10,15,20,.12)}.primary-action span{margin-left:14px}.quiet-action:hover,.outline-action:hover{border-color:#bdc9d3;background:#fbfcfd}.outline-action{width:100%;margin-top:22px}.text-button,.text-danger{padding:8px 0;border:0;background:transparent;color:#8a95a4}.text-danger{color:#ca6674}.owner-summary-body{display:grid;grid-template-columns:auto 1fr 1px 1fr;gap:18px;align-items:center;margin:26px 6px}.owner-summary-body>i{width:1px;height:42px;background:#e1e6eb}.owner-summary-body strong{display:block;font-size:30px;font-weight:300}.owner-summary-body small{display:block;margin-top:4px;color:#9ca7b6;font-size:10px}.monitor-box{display:flex;align-items:center;gap:16px;padding:15px;background:linear-gradient(135deg,#f4fbfb,#f8fbff);border-radius:14px}.radar{width:72px;height:72px;position:relative;display:grid;place-items:center;flex:none}.radar i{grid-area:1/1;border-radius:50%;border:1px solid rgba(24,195,174,.35);animation:radarPulse 3s ease-in-out infinite}.radar i:nth-child(1){width:70px;height:70px}.radar i:nth-child(2){width:50px;height:50px;animation-delay:.3s}.radar i:nth-child(3){width:30px;height:30px;animation-delay:.6s}.radar b{grid-area:1/1;width:10px;height:10px;border-radius:50%;background:#16c4a9;box-shadow:0 0 0 7px rgba(22,196,169,.09)}@keyframes radarPulse{0%,100%{opacity:.5;transform:scale(.98)}50%{opacity:1;transform:scale(1.04)}}.monitor-box strong{font-size:13px;font-weight:500}.monitor-box p{margin:4px 0 0;color:#98a3b2;font-size:10px;line-height:1.35}.monitor-list{list-style:none;margin:12px 0 0;padding:0}.monitor-list li{display:flex;justify-content:space-between;gap:12px;padding:4px 0;font-size:10px;color:#8e99a8}.monitor-list li b{color:#25b96a;font-weight:500}.kpis{display:grid;grid-template-columns:repeat(6,1fr);gap:10px;margin-top:14px}.kpis article{padding:15px 18px;border:1px solid var(--line);border-radius:14px;background:#fff}.kpis span{font-size:10px;color:#95a0af}.kpis strong{display:block;margin-top:6px;font-size:27px;font-weight:300}.kpis small{font-size:9px;color:#a9b2be}.section-card{margin-top:14px;padding:24px}.section-heading{display:flex;justify-content:space-between;align-items:flex-start;gap:20px;margin-bottom:18px}.section-heading h2{margin:0;font-size:24px;font-weight:350;letter-spacing:-.025em}.section-heading h3{font-weight:400}.section-heading p{margin:5px 0 0;color:#9aa5b4;font-size:11px;line-height:1.45}.section-heading.compact{margin-bottom:12px}.eyebrow{margin:0 0 6px!important;font-size:9px!important;letter-spacing:.16em;color:#8f9baa!important}.section-note{max-width:430px;text-align:right;font-size:10px;color:#99a4b3;line-height:1.45}.soft-note{padding:11px 13px;border-radius:11px;background:#f8fafb;color:#8f9aa9;font-size:10px;line-height:1.5}.table-scroll{overflow:auto;border:1px solid #edf1f4;border-radius:13px}table{width:100%;border-collapse:collapse;min-width:980px}th,td{padding:12px 11px;text-align:left;border-bottom:1px solid #eef2f4;font-size:11px}th{background:#f8fafb;color:#96a1b0;font-size:9px;font-weight:500;letter-spacing:.04em}tbody tr:hover{background:#fcfdfe}tbody tr:last-child td{border-bottom:0}.exchange-summary{padding:13px 15px;border:1px solid #e2ebef;border-radius:12px;background:#f7fbfc;color:#52626d;font-size:12px;margin-bottom:14px}.steps{display:grid;gap:10px}.step-card{border:1px solid #e6ebef;border-radius:14px;padding:16px;background:#fff}.step-head{display:flex;align-items:center;gap:10px}.step-head strong{width:30px;height:30px;border-radius:50%;display:grid;place-items:center;background:#e8faf7;color:#13ae9b;font-weight:500}.step-head h3{margin:0;font-size:16px;font-weight:400}.money-line{font-size:14px;font-weight:500}.step-card ol{padding-left:20px;color:#8793a2;font-size:11px;line-height:1.5}.button-link{background:#22282d;color:#fff;border-color:#22282d}.source-link{color:#758b9c;text-decoration:none;font-size:11px}.bank-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(225px,1fr));gap:10px}.bank-card{border:1px solid #e6ebef;border-radius:14px;padding:15px;background:#fff}.bank-card h3{margin:0 0 6px;font-size:14px;font-weight:400}.bank-card .muted,.source-note{font-size:10px;color:#919cab;line-height:1.45}.bank-card a{color:#6d8799;text-decoration:none;font-size:10px}.source-status{font-size:10px;color:#647888;margin:8px 0 5px}.owner-grid{max-height:650px;overflow:auto;padding-right:2px}.owner-bank-card:has([data-owner-owned]:checked){border-color:#b9e8df;background:#fbfefd}.owner-bank-card:has([data-owner-sbp]:checked){box-shadow:inset 0 0 0 1px #abe0d5}.owner-warning{font-size:10px;color:#ad7b30}.diagnostics{margin-top:14px;overflow:hidden}.diagnostics summary{cursor:pointer;list-style:none;padding:20px 24px;display:flex;justify-content:space-between;align-items:center}.diagnostics summary::-webkit-details-marker{display:none}.diagnostics summary strong{font-weight:400}.diagnostics summary span{font-size:10px;color:#8d98a7}.diagnostic-body{padding:0 24px 24px}.diagnostic-body>section{padding-top:18px;border-top:1px solid #eef2f4}.diagnostic-body>section+section{margin-top:18px}.event{display:grid;grid-template-columns:90px 1fr 1fr 2fr;gap:8px;padding:7px 0;border-bottom:1px solid #f0f3f5;font-size:10px;color:#8c97a6}.output pre{white-space:pre-wrap;word-break:break-word;max-height:340px;overflow:auto;background:#f8fafb;border:1px solid #ebeff2;border-radius:12px;padding:14px;color:#65717e;font-size:10px}.hidden{display:none!important}footer{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;padding:28px 4px 6px;color:#a2acb8;font-size:8px;letter-spacing:.15em}@media(max-width:1180px){.work-grid{grid-template-columns:1fr 1fr}.monitor-card{grid-column:1/-1}.feature-grid{grid-template-columns:1fr 1fr}.coverage-bar{gap:18px}.coverage-bar>p{display:none}.kpis{grid-template-columns:repeat(3,1fr)}}@media(max-width:760px){main{width:min(95vw,720px);padding-top:4px}.hero{height:270px}.hero-side{display:none}.hero-title h1{font-size:56px}.hero-title h2{font-size:19px}.hero-title p{font-size:12px}.coverage-bar{flex-wrap:wrap;gap:12px 18px;padding:10px 0}.coverage-bar>i{height:24px}.coverage-bar strong{font-size:28px}.coverage-bar span{font-size:10px}.feature-grid,.work-grid{grid-template-columns:1fr}.monitor-card{grid-column:auto}.settings-grid{grid-template-columns:1fr 1fr}.kpis{grid-template-columns:1fr 1fr}.section-heading{flex-direction:column}.section-note{text-align:left}.feature-card{min-height:110px}.owner-summary-body{grid-template-columns:auto 1fr 1px 1fr}}@media(max-width:520px){.hero{height:230px}.hero-title h1{font-size:43px}.hero-title h2{font-size:16px}.hero-title p{display:none}.coverage-bar article{gap:7px}.coverage-bar>i:nth-of-type(3){display:none}.feature-grid{gap:9px}.feature-card{padding:16px}.feature-icon,.big-icon{width:44px;height:44px}.settings-grid,.kpis{grid-template-columns:1fr}.work-card,.section-card{padding:18px}.control-row button,.primary-action{width:100%}.owner-summary-body{gap:11px}.event{grid-template-columns:76px 1fr}.event span:nth-child(n+3){display:none}footer{justify-content:center;text-align:center}#network-canvas{opacity:.88}}
.scan-progress{height:4px;margin-top:12px;border-radius:99px;background:#edf2f5;overflow:hidden;opacity:.35}.scan-progress i{display:block;width:34%;height:100%;border-radius:inherit;background:linear-gradient(90deg,var(--cyan),var(--teal),var(--lime));transform:translateX(-120%)}.scanner-card.is-scanning .scan-progress{opacity:1}.scanner-card.is-scanning .scan-progress i{animation:aionScanMove 1.05s ease-in-out infinite}.scan-status{margin:8px 2px 0;min-height:18px;font-size:11px;color:#7f8c9b;line-height:1.45}.scanner-card.is-scanning .scan-status{color:#2f6672;font-weight:500}.primary-action:disabled,.quiet-action:disabled{cursor:wait;opacity:.62}.primary-action.is-loading{animation:aionSearchPulse 1.05s ease-in-out infinite}@keyframes aionScanMove{0%{transform:translateX(-120%)}55%{transform:translateX(210%)}100%{transform:translateX(360%)}}@keyframes aionSearchPulse{0%,100%{opacity:.68}50%{opacity:1}}

.lime .feature-icon{background:#f3fad8;color:#86a900}.window-summary{margin-top:10px!important;color:#596673!important;font-weight:500}.window-state{font-weight:600;white-space:nowrap}.window-state-suspected{color:#ad7b30}.window-state-confirmed{color:#0d8fa5}.window-state-stable{color:#14975d}.window-history{margin-top:14px;border-top:1px solid #edf1f4;padding-top:12px}.window-history>summary{cursor:pointer;color:#667684;font-size:11px;display:flex;gap:8px;align-items:center}.window-history>summary span{display:inline-grid;place-items:center;min-width:22px;height:22px;border-radius:99px;background:#f2f6f8;color:#566674}.window-history .table-scroll{margin-top:10px}

/* Crypto Radar additions */
.paper-kpi{font-size:22px!important}.window-placeholder{display:flex;align-items:center;gap:18px;padding:18px;border:1px dashed #dce5ea;border-radius:14px;background:linear-gradient(135deg,#fbfeff,#fbfdfc)}.window-placeholder strong{font-size:14px;font-weight:450}.window-placeholder p{margin:5px 0 0;color:#98a3b2;font-size:11px}.crypto-radar{width:64px;height:64px}.profit-chip{display:inline-flex;align-items:center;gap:6px;border-radius:999px;padding:6px 10px;background:#e8faf2;color:#15985a;font-weight:650;white-space:nowrap}.route-text{max-width:560px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#657482}.route-kind{display:inline-block;margin-left:8px;padding:3px 7px;border-radius:999px;background:#f0f5f8;color:#71808d;font-size:9px;text-transform:uppercase}.step-meta{display:flex;gap:12px;flex-wrap:wrap;color:#8b97a6;font-size:10px;margin-top:7px}.step-route{font-family:Consolas,monospace;color:#596775;font-size:11px;word-break:break-word}.danger-note{color:#bf6570!important}.success-note{color:#15985a!important;font-weight:500}.scanner-card select:disabled,.scanner-card input:disabled{opacity:.55;cursor:not-allowed}.scanner-card #start-asset{pointer-events:none}.coverage-bar strong{min-width:40px;text-align:right}@media(max-width:900px){.window-placeholder{align-items:flex-start}.route-text{max-width:320px}}
.source-health{white-space:pre-wrap;margin:10px 0 0;padding:12px 14px;border:1px solid #e8edf2;border-radius:12px;background:#f8fafb;color:#65717e;font:10px/1.6 Consolas,monospace}
.window-placeholder:has(.window-live-card){display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));align-items:stretch}.window-live-card{padding:14px;border:1px solid #e7edf1;border-radius:13px;background:#fff}.window-live-card strong{display:block;margin-top:8px;font-size:12px}.window-live-card p{margin:5px 0 0!important;font-size:10px;color:#8d98a7}

.verification-note{font-size:9px;color:#7b8794;white-space:nowrap}.success-note{color:#14975d;font-weight:600}#prefunded-panel tbody tr:hover{background:#f8fcfb}

/* confirmed routes + notifications */
#prefunded-panel tbody tr.confirmed-row{background:linear-gradient(90deg,#f2fcf7,#fbfefd);cursor:pointer;border-left:3px solid #20c66b}.confirmed-row:hover{background:#ebfaf2!important}.confirmed-row:focus{outline:2px solid rgba(32,198,107,.35);outline-offset:-2px}.confirmed-badge{display:inline-flex;align-items:center;border-radius:999px;padding:5px 8px;background:#e4f8ec;color:#13894f;font-weight:700;font-size:9px;white-space:nowrap}.pending-badge{display:block;margin-top:5px;color:#ae7d29;font-size:8px;white-space:nowrap}.chain-action{border:1px solid #bde8cd;background:#f0fbf4;color:#11864d;border-radius:10px;padding:8px 10px;font-size:10px;font-weight:650;cursor:pointer;white-space:nowrap}.chain-action:hover{background:#e3f8eb}.step-warning{border-color:#f0dfba;background:#fffdf7}.step-warning .step-head strong{background:#fff2d8;color:#ac7a20}
#toast-stack{position:fixed;right:18px;top:18px;z-index:9999;width:min(360px,calc(100vw - 36px));display:grid;gap:9px;pointer-events:none}.opportunity-toast{appearance:none;width:100%;border:1px solid #b8e8c9;border-left:4px solid #20c66b;border-radius:14px;background:rgba(246,255,249,.97);box-shadow:0 14px 42px rgba(31,88,56,.16);padding:12px 13px;display:grid;grid-template-columns:auto 1fr;gap:10px;text-align:left;color:#244332;cursor:pointer;pointer-events:auto;opacity:0;transform:translateX(24px);transition:.22s ease}.opportunity-toast.show{opacity:1;transform:translateX(0)}.toast-dot{width:10px;height:10px;border-radius:50%;background:#20c66b;box-shadow:0 0 0 5px rgba(32,198,107,.10);margin-top:6px}.toast-copy{display:grid;gap:3px}.toast-copy strong{font-size:10px;letter-spacing:.02em;color:#168b50}.toast-copy b{font-size:12px;font-weight:600;color:#294638}.toast-copy small{font-size:9px;color:#648071;line-height:1.45}.summary-toast{cursor:default}.summary-toast .toast-dot{background:#60b988}@media(max-width:700px){#toast-stack{right:10px;top:10px;width:calc(100vw - 20px)}.opportunity-toast{padding:10px 11px}}

/* Full-loop verification states */
#prefunded-panel tbody tr.full-loop-row{background:linear-gradient(90deg,#effcf5,#fbfffd);box-shadow:inset 4px 0 0 #20c66b;cursor:pointer}
#prefunded-panel tbody tr.full-loop-row:hover{background:#eafaf2}.confirmed-badge{display:inline-flex;padding:5px 8px;border-radius:999px;background:#dcf8e8;color:#128a50;font-size:9px;font-weight:700;white-space:nowrap}.full-badge-note{display:block;margin-top:4px;color:#5c9b78;font-size:8px}.pending-row{background:#fffdf7;box-shadow:inset 3px 0 0 #e6b64d}.market-badge{display:inline-flex;padding:5px 8px;border-radius:999px;background:#fff4d8;color:#9a6c18;font-size:9px;font-weight:700;white-space:nowrap}.pending-badge{display:block;margin-top:4px;color:#a28d67;font-size:8px;max-width:220px;white-space:normal}.step-warning{background:#fffdf7;border-color:#f1dfb4}.chain-action{border:1px solid #bcebd1;background:#eafaf2;color:#128a50;border-radius:10px;padding:9px 11px;font-size:10px;font-weight:650;cursor:pointer;white-space:nowrap}

/* Strict full-loop states */
.full-loop-row{background:linear-gradient(90deg,rgba(32,198,107,.075),rgba(32,198,107,.018))}.full-loop-row:hover{background:rgba(32,198,107,.105)!important}.full-loop-row td:first-child{border-left:3px solid var(--green)}
.full-badge{display:inline-flex;padding:5px 9px;border-radius:999px;background:#def8e9;color:#11864d;font-size:9px;font-weight:700;letter-spacing:.04em;white-space:nowrap}.pending-row{background:linear-gradient(90deg,rgba(235,176,54,.055),transparent)}.pending-row td:first-child{border-left:3px solid #e5ad39}.candidate-net{color:#a67415;font-weight:600}.pending-reason{color:#9b7a3d;font-size:9px;text-transform:lowercase}.step-warning{border-color:#eddcae;background:#fffdf7}.chain-action{border:1px solid #b8e5ca;background:#ebfaf1;color:#12834c;border-radius:10px;padding:8px 11px;cursor:pointer;font-size:10px;font-weight:650;white-space:nowrap}.chain-action:hover{background:#dcf6e7}.opportunity-toast{border-color:#bce9cf!important;background:rgba(242,255,248,.97)!important}.toast-dot{background:var(--green)!important;box-shadow:0 0 0 6px rgba(32,198,107,.1)}
.batch-ready-row{background:linear-gradient(90deg,rgba(18,189,220,.07),rgba(32,198,107,.03))!important}.batch-ready-row td:first-child{border-left:3px solid #12bddc}.batch-toast{border-left-color:#12bddc!important}.batch-toast .toast-dot{background:#12bddc!important;box-shadow:0 0 0 6px rgba(18,189,220,.1)!important}.recently-closed-row{background:#f7f8f9;color:#8994a2}.recently-closed-row td:first-child{border-left:3px solid #aeb8c1}.closed-status{color:#7e8995;font-weight:650;white-space:nowrap}

/* Latency arbitrage */
.latency-ready-row{background:linear-gradient(90deg,rgba(17,190,220,.09),rgba(20,200,182,.025));cursor:pointer}.latency-ready-row td:first-child{border-left:3px solid var(--cyan)}.latency-ready-row:hover{background:rgba(17,190,220,.105)!important}.latency-status{color:#078fa9;font-weight:700;white-space:nowrap}.latency-toast{border-left-color:var(--cyan)!important;background:rgba(244,253,255,.98)!important}.latency-toast .toast-dot{background:var(--cyan)!important;box-shadow:0 0 0 6px rgba(19,190,220,.11)!important}.latency-toast .toast-copy strong{color:#078fa9}.feature-grid{grid-template-columns:repeat(6,1fr)}@media(max-width:1350px){.feature-grid{grid-template-columns:repeat(3,1fr)}}@media(max-width:760px){.feature-grid{grid-template-columns:1fr}}

.latency-repeatable-row{background:linear-gradient(90deg,rgba(32,198,107,.10),rgba(32,198,107,.02));cursor:pointer}.latency-repeatable-row td:first-child{border-left:3px solid var(--green)}.latency-repeatable-row:hover{background:rgba(32,198,107,.12)!important}

/* Quality Engine */
.quality-good-row{background:linear-gradient(90deg,rgba(32,198,107,.08),transparent)}
.quality-good-row td:first-child{border-left:3px solid var(--green)}
.score-high{color:#11864d;font-weight:700}.score-mid{color:#9a721f;font-weight:650}
#quality-panel tbody tr:hover,#long-panel tbody tr:hover{background:#f8fcfb}

/* CLASSIC sustainable states */
.classic-watch-row{background:linear-gradient(90deg,rgba(229,173,57,.06),transparent);cursor:pointer}.classic-watch-row td:first-child{border-left:3px solid #e5ad39}.classic-watch-row:hover{background:rgba(229,173,57,.09)!important}.sustainable-exec-row{cursor:pointer;background:linear-gradient(90deg,rgba(32,198,107,.12),transparent)!important}.sustainable-exec-row:hover{background:rgba(32,198,107,.16)!important}.sustainable-exec-row td:first-child{border-left:3px solid var(--green)}.sustainable-toast{border-left-color:var(--green)!important;background:rgba(240,255,247,.99)!important}.sustainable-toast .toast-copy strong{color:#0f8a4b!important}

/* v0.6 autopilot */
.autopilot-box{margin-top:14px;padding:15px;border:1px solid #e7edf1;border-radius:14px;background:linear-gradient(135deg,#fbfefe,#fbfcff)}
.autopilot-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.autopilot-grid label{font-size:10px;color:#8d98a7}.autopilot-grid input{width:100%;margin-top:6px;padding:10px 11px;border:1px solid #dfe6ec;border-radius:10px;background:#fff;color:#34383d}
.strategy-toggles{display:flex;gap:16px;flex-wrap:wrap;margin:12px 0 4px}.strategy-toggles label{font-size:10px;color:#657482;display:flex;gap:6px;align-items:center}.sustainable-exec-row{cursor:pointer}.sustainable-exec-row:hover{background:#edf9f2!important}
@media(max-width:900px){.autopilot-grid{grid-template-columns:1fr 1fr}}@media(max-width:520px){.autopilot-grid{grid-template-columns:1fr}}

/* Trading mode selector */
.trading-mode-bar{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin:4px 0 10px;padding:10px 12px;border:1px solid #e7edf1;border-radius:12px;background:#f9fbfc}
.trading-mode-bar>span{font-size:10px;color:#8d98a7;margin-right:4px}.trading-mode-bar>b{margin-left:auto;font-size:10px;color:#53616d;font-weight:600}
.mode-choice{border:1px solid #dfe6eb;background:#fff;color:#62707d;border-radius:9px;padding:7px 10px;font-size:9px;font-weight:650;cursor:pointer}
.mode-choice.active-mode{border-color:#9adfca;background:#e9faf3;color:#11864d;box-shadow:0 0 0 2px rgba(32,198,107,.06)}
.mode-choice.danger-mode{color:#b05a65}.mode-choice.danger-mode.active-mode{border-color:#edb8be;background:#fff1f3;color:#b84655}
.demo-readiness{font-size:9px;color:#778694;margin:0 0 12px;padding:8px 10px;border-radius:9px;background:#f6f9fb}
@media(max-width:700px){.trading-mode-bar>b{width:100%;margin-left:0}.mode-choice{flex:1}}

/* CoinW pilot audit */
.pilot-off{color:#8f9aa8!important}.pilot-pass-row{background:linear-gradient(90deg,rgba(32,198,107,.12),transparent)}.pilot-pass-row td:first-child{border-left:3px solid var(--green)}#coinw-pilot-panel .control-row{margin-bottom:14px}#coinw-pilot-panel .soft-note{margin:0;flex:1}.auto-kpis{grid-template-columns:repeat(6,1fr)}@media(max-width:1100px){.auto-kpis{grid-template-columns:repeat(3,1fr)}}@media(max-width:650px){.auto-kpis{grid-template-columns:1fr 1fr}}

.pilot-history{display:grid;grid-template-columns:220px 1fr;gap:14px;align-items:center;margin:10px 0 14px;padding:12px 14px;border:1px solid var(--line);border-radius:13px;background:#fbfcfd}.pilot-history strong{display:block;font-size:11px;font-weight:500}.pilot-history small{display:block;margin-top:4px;color:#8f9aa8;font-size:9px;line-height:1.4}.pilot-history-chart{height:72px;display:flex;gap:3px;align-items:stretch;position:relative;background:linear-gradient(to bottom,transparent 49%,#dfe5ea 50%,transparent 51%);padding:4px}.pilot-history-chart i{position:relative;flex:1;min-width:3px;max-width:14px}.pilot-history-chart i:before{content:'';position:absolute;left:1px;right:1px;top:min(var(--zero),var(--pos));bottom:calc(100% - max(var(--zero),var(--pos)));border-radius:3px;background:#d76570;min-height:2px}.pilot-history-chart i.positive:before{background:#7fb6c1}.pilot-history-chart i.candidate:before{background:#e5ad39}.pilot-history-chart i.strict:before{background:#20c66b}@media(max-width:760px){.pilot-history{grid-template-columns:1fr}.pilot-history-chart{height:62px}}

.pilot-verdict{display:flex;align-items:center;justify-content:space-between;gap:14px;margin:4px 0 12px;padding:12px 14px;border-radius:12px;border:1px solid #e5eaee;background:#f8fafb}.pilot-verdict strong{font-size:11px;letter-spacing:.04em}.pilot-verdict span{font-size:9px;color:#7f8b98;text-align:right}.pilot-verdict.wait{border-left:4px solid #aeb8c1}.pilot-verdict.candidate{border-left:4px solid #e5ad39;background:#fffaf0}.pilot-verdict.pass{border-left:4px solid var(--green);background:#effcf5}.pilot-verdict.pass strong{color:#12864d}.pilot-verdict.candidate strong{color:#9a6c18}@media(max-width:650px){.pilot-verdict{align-items:flex-start;flex-direction:column}.pilot-verdict span{text-align:left}}

/* v0.11.9 CoinW ↔ Bitget server AUTO audit */
.pilot-auto-strip{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin:-2px 0 12px;padding:10px 12px;border:1px solid #dfeee8;border-radius:12px;background:linear-gradient(90deg,#f4fdf8,#f8fcff);font-size:10px;color:#73808d}.pilot-auto-strip strong{color:#168b50;font-size:10px;letter-spacing:.04em}.pilot-live-dot{width:8px;height:8px;border-radius:50%;background:#20c66b;box-shadow:0 0 0 5px rgba(32,198,107,.10);animation:pilotLive 1.6s ease-in-out infinite}.pilot-auto-strip span:not(.pilot-live-dot){padding-left:9px;border-left:1px solid #e0e8eb}@keyframes pilotLive{0%,100%{opacity:.55}50%{opacity:1;box-shadow:0 0 0 8px rgba(32,198,107,.05)}}
